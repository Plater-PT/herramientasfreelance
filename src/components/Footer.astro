---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} {SITE_TITLE}. Todos los derechos reservados.</p>
	<p class="legal-links">
	<a href="/privacidad">Política de Privacidad</a> · <a href="/aviso-legal">Aviso Legal</a>
</p>
</footer>
<style>
	footer {
		padding: 2.5em 1em 4em 1em;
		border-top: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.9em;
	}
	footer p {
		margin: 0;
	}
	.legal-links {
	margin-top: 0.5em;
	font-size: 0.85em;
}
.legal-links a {
	color: rgb(var(--gray));
}
</style>