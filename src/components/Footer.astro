---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} {SITE_TITLE}. Todos los derechos reservados.</p>
</footer>
<style>
	footer {
		padding: 2.5em 1em 4em 1em;
		border-top: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.9em;
	}
	footer p {
		margin: 0;
	}
</style>