---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="banner">
				<h1>Artículos</h1>
				<p>Herramientas de IA, gadgets y guías prácticas — probado antes de recomendarlo.</p>
			</section>

			<ul class="grid">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<Image
										class="thumb"
										width={480}
										height={270}
										src={post.data.heroImage}
										alt=""
									/>
								)}
								<span class="post-title">{post.data.title}</span>
								<span class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
								<span class="post-description">{post.data.description}</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 64rem;
		overflow-x: hidden;
	}

	.banner {
		background: var(--accent);
		color: #f4f1ea;
		padding: 3rem 2rem;
		border-radius: 6px;
		margin-bottom: 3rem;
	}

	.banner h1 {
		color: #f4f1ea;
		font-size: 2rem;
		margin: 0 0 0.5rem;
	}

	.banner p {
		margin: 0;
		font-size: 1.05rem;
		opacity: 0.9;
		max-width: 40ch;
	}

	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
		gap: 2rem;
	}

	.grid li a {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: inherit;
		height: 100%;
	}

	.thumb {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: 6px;
		margin-bottom: 0.75rem;
	}

	.post-title {
		display: block;
		font-family: var(--font-heading);
		font-size: 1.15rem;
		font-weight: 500;
		color: rgb(var(--black));
		line-height: 1.3;
		margin-bottom: 0.3rem;
	}

	.grid li a:hover .post-title {
		color: var(--accent);
	}

	.post-date {
		display: block;
		font-size: 0.8rem;
		color: rgb(var(--gray));
		margin-bottom: 0.5rem;
	}

	.post-description {
		display: block;
		font-size: 0.9rem;
		color: rgb(var(--gray-dark));
		line-height: 1.5;
	}

	@media (max-width: 40rem) {
		.banner {
			padding: 2rem 1.5rem;
		}

		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>